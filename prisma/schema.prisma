generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id           String   @id @default(cuid())
  filename     String   @unique
  originalName String?
  mimeType     String?
  size         Int?
  path         String
  alt          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
